# База данных Postgres (Neon) — строка подключения из панели Neon.
# Добавить &connect_timeout=30 в конец — на бесплатном тарифе Neon база
# "засыпает" при простое, и стандартного таймаута не хватает, чтобы дождаться
# пробуждения (см. https://neon.com/docs/guides/prisma, ошибка "Can't reach
# database server", проверено 2026-09-07).
DATABASE_URL=

# Resend — API-ключ из resend.com (Dashboard → API Keys).
RESEND_API_KEY=
# Адрес отправителя. До подтверждения домена в Resend можно временно
# использовать onboarding@resend.dev.
EMAIL_FROM=

# Секрет для подписи ссылок скачивания готового плана (magic-link, без пароля).
# Свой, случайный — например, сгенерировать: openssl rand -hex 32
AUTH_SECRET=

# ChadGPT — доступ к Claude для генерации текста плана (chadgpt.ru).
# Российский сервис, оплата рублями — выбран вместо прямого Anthropic API,
# так как российские карты не работают с console.anthropic.com напрямую.
# Ключ — в личном кабинете chadgpt.ru → API.
# Без ключа сайт принимает оплату, но не может собрать документ.
CHADGPT_API_KEY=
# Подтверждено документацией support.chadgpt.ru (раздел API → Текстовые модели,
# проверено 2026-09-06) — не менять без необходимости.
CHADGPT_MODEL=claude-5-sonnet

# ——— Приём оплат: ЮKassa (ключи из личного кабинета, Интеграция → Ключи API) ———
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Код НДС в чеке: 1 — «без НДС» (УСН, патент). Меняем, если налоговая система другая.
YOOKASSA_VAT_CODE=1

# Адрес сайта (используется в ссылках писем и возврате с оплаты).
SITE_URL=http://localhost:3000

# Яндекс.Метрика — номер счётчика (создать на metrika.yandex.ru). Можно оставить пустым.
NEXT_PUBLIC_METRIKA_ID=
